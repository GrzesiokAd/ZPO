<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="500.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/23.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.controller.ProjectController">
    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <TextField fx:id="txtSzukaj" prefWidth="250.0" promptText="Szukaj"/>
                <Button mnemonicParsing="false" onAction="#onActionBtnSzukaj" text="Szukaj"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Rozmiar strony:"/>
                <ChoiceBox fx:id="cbPageSizes" prefWidth="80.0"/>
                <Button mnemonicParsing="false" onAction="#onActionBtnDodaj" text="Dodaj"/>
            </HBox>
            <HBox alignment="CENTER" spacing="8.0">
                <Button fx:id="btnPierwsza" mnemonicParsing="false" onAction="#onActionBtnPierwsza" text="❙◄"/>
                <Button fx:id="btnWstecz" mnemonicParsing="false" onAction="#onActionBtnWstecz" text="◄"/>
                <Button fx:id="btnDalej" mnemonicParsing="false" onAction="#onActionBtnDalej" text="►"/>
                <Button fx:id="btnOstatnia" mnemonicParsing="false" onAction="#onActionBtnOstatnia" text="►❙"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tblProjekt" prefHeight="400.0" prefWidth="850.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="Id"/>
                <TableColumn fx:id="colNazwa" prefWidth="150.0" text="Nazwa"/>
                <TableColumn fx:id="colOpis" prefWidth="250.0" text="Opis"/>
                <TableColumn fx:id="colDataCzasUtworzenia" prefWidth="160.0" text="Data utworzenia"/>
                <TableColumn fx:id="colDataOddania" prefWidth="130.0" text="Data oddania"/>
            </columns>
        </TableView>
    </center>
</BorderPane>